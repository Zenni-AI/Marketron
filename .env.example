# Required for the AI planning layer (Claude makes the real editorial decisions:
# clip selection/order, before/after pairing, hook choice, captions, logo placement).
# Without this set, /api/jobs/:id/plan will fail with a clear error.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for planning (defaults to claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5

# Where uploaded assets and rendered outputs are stored on local disk.
STORAGE_ROOT=./storage

# SQLite DB file used by Prisma for the MVP. Use an ABSOLUTE path here — the
# same value has to resolve to the same file from both the CLI (run from
# packages/core) and the Next.js app (run from apps/web), and a relative
# `file:` URL's resolution base differs enough between contexts that it's not
# worth relying on.
DATABASE_URL="file:/absolute/path/to/repo/packages/core/prisma/dev.db"

# Optional: point Remotion at a pre-installed Chromium instead of downloading one
# (this sandbox has one at /opt/pw-browsers/chromium).
REMOTION_BROWSER_EXECUTABLE=

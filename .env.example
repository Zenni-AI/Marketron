# Port the lead API listens on (the Vite dev server proxies /api here).
PORT=5174

# Token required by the /admin dashboard and the admin API routes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me-before-deploying

# Where leads are appended as JSON Lines. Anything under data/ is git-ignored.
LEAD_STORE_PATH=data/leads.jsonl

# Optional: every accepted lead is also POSTed here as JSON (CRM, Zapier, Make,
# HubSpot workflow, Salesforce Web-to-Lead proxy...). Leave blank to disable.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Branding shown in the funnel.
VITE_COMPANY_NAME=Marketron Solar
VITE_COMPANY_PHONE=(800) 555-0142

# Resend API key used by /api/bid to email bid form submissions.
# Create one at https://resend.com/api-keys and set it in your deploy
# environment (Vercel: Project Settings -> Environment Variables).
# Never commit a real key.
RESEND_API_KEY=

# Optional overrides.
# Where bid requests are delivered. Defaults to the bids@jvspainting.com
# placeholder in app/api/bid/route.ts — set this to the real inbox.
BID_INBOX=

# Verified Resend sender. Defaults to Resend's onboarding@resend.dev until
# jvspainting.com is verified in the Resend dashboard.
BID_FROM=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("draft")
  createdAt DateTime @default(now())

  jobAssets JobAsset[]
  editPlans EditPlan[]
  renders   Render[]
}

/// A single uploaded video or photo, living in the shared library — not
/// owned by any one job. Jobs pull assets in (old or newly uploaded) via
/// JobAsset, so the same clip/photo can be reused across multiple jobs
/// without re-uploading.
model Asset {
  id           String   @id @default(cuid())
  kind         String
  filePath     String
  originalName String
  mimeType     String
  durationSec  Float?
  width        Int?
  height       Int?
  analysisHash String?
  createdAt    DateTime @default(now())

  jobAssets JobAsset[]
}

/// Join table: which library assets a given job is currently using.
model JobAsset {
  id      String   @id @default(cuid())
  jobId   String
  job     Job      @relation(fields: [jobId], references: [id])
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id])
  addedAt DateTime @default(now())

  @@unique([jobId, assetId])
  @@index([jobId])
  @@index([assetId])
}

model EditPlan {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  templateId String
  planJson   String
  createdAt  DateTime @default(now())

  renders Render[]

  @@index([jobId])
}

model Render {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])
  editPlanId   String
  editPlan     EditPlan @relation(fields: [editPlanId], references: [id])
  format       String
  filePath     String?
  status       String   @default("pending")
  reviewStatus String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([jobId])
  @@index([editPlanId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("draft")
  createdAt DateTime @default(now())

  assets    Asset[]
  editPlans EditPlan[]
  renders   Render[]
}

model Asset {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])
  kind         String
  filePath     String
  originalName String
  mimeType     String
  durationSec  Float?
  width        Int?
  height       Int?
  analysisHash String?
  createdAt    DateTime @default(now())

  @@index([jobId])
}

model EditPlan {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  templateId String
  planJson   String
  createdAt  DateTime @default(now())

  renders Render[]

  @@index([jobId])
}

model Render {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])
  editPlanId   String
  editPlan     EditPlan @relation(fields: [editPlanId], references: [id])
  format       String
  filePath     String?
  status       String   @default("pending")
  reviewStatus String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([jobId])
  @@index([editPlanId])
}
